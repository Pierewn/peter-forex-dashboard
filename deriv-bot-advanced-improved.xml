<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable type="" id="profit_var">Profit</variable>
    <variable type="" id="stake_var">Stake</variable>
    <variable type="" id="target_var">Target Profit</variable>
    <variable type="" id="stop_loss_var">Stop Loss</variable>
    <variable type="" id="win_count_var">Win Count</variable>
    <variable type="" id="loss_count_var">Loss Count</variable>
    <variable type="" id="consecutive_losses">Consecutive Losses</variable>
    <variable type="" id="first_stake">First Stake</variable>
    <variable type="" id="martingale_enabled">Martingale Enabled</variable>
    <variable type="" id="last_prediction">Last Prediction</variable>
  </variables>
  <block type="trade_definition" id="trade_def_main" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_block" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_50</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_block" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_block" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candleinterval_block" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">1</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_block" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restarterror_block" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_first_stake">
        <field name="VAR" id="first_stake">First Stake</field>
        <value name="VALUE">
          <block type="math_number" id="first_stake_value">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_stake">
            <field name="VAR" id="stake_var">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="stake_value">
                <field name="VAR" id="first_stake">First Stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_profit">
                <field name="VAR" id="profit_var">Profit</field>
                <value name="VALUE">
                  <block type="math_number" id="profit_value">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_target">
                    <field name="VAR" id="target_var">Target Profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="target_value">
                        <field name="NUM">100</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_stop_loss">
                        <field name="VAR" id="stop_loss_var">Stop Loss</field>
                        <value name="VALUE">
                          <block type="math_number" id="stop_loss_value">
                            <field name="NUM">-50</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_win_count">
                            <field name="VAR" id="win_count_var">Win Count</field>
                            <value name="VALUE">
                              <block type="math_number" id="win_count_value">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="init_loss_count">
                                <field name="VAR" id="loss_count_var">Loss Count</field>
                                <value name="VALUE">
                                  <block type="math_number" id="loss_count_value">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="init_consecutive">
                                    <field name="VAR" id="consecutive_losses">Consecutive Losses</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="consecutive_value">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="init_martingale">
                                        <field name="VAR" id="martingale_enabled">Martingale Enabled</field>
                                        <value name="VALUE">
                                          <block type="logic_boolean" id="martingale_value">
                                            <field name="BOOL">FALSE</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set" id="init_prediction">
                                            <field name="VAR" id="last_prediction">Last Prediction</field>
                                            <value name="VALUE">
                                              <block type="text" id="prediction_value">
                                                <field name="TEXT">rise</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tradeoptions_block" collapsed="true">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="duration_value">
            <field name="NUM">2</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amount_value">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="stake_get">
            <field name="VAR" id="stake_var">Stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="before_purchase_block" deletable="false" x="0" y="600">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="check_stop_loss">
        <value name="IF0">
          <block type="logic_compare" id="stop_loss_check">
            <field name="OP">LTE</field>
            <value name="A">
              <block type="variables_get" id="profit_check">
                <field name="VAR" id="profit_var">Profit</field>
              </block>
            </value>
            <value name="B">
              <block type="variables_get" id="stop_loss_check">
                <field name="VAR" id="stop_loss_var">Stop Loss</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="notify" id="stop_loss_notify">
            <field name="NOTIFICATION_TYPE">error</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <block type="text" id="stop_loss_message">
                <field name="TEXT">STOP LOSS HIT! Bot stopped.</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="DO1">
          <block type="controls_if" id="check_target">
            <value name="IF0">
              <block type="logic_compare" id="target_check">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="variables_get" id="profit_target_check">
                    <field name="VAR" id="profit_var">Profit</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="target_get">
                    <field name="VAR" id="target_var">Target Profit</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="notify" id="target_notify">
                <field name="NOTIFICATION_TYPE">success</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <block type="text" id="target_message">
                    <field name="TEXT">TARGET PROFIT REACHED!</field>
                  </block>
                </value>
              </block>
            </statement>
            <statement name="DO1">
              <block type="purchase" id="purchase_block">
                <field name="PURCHASE_LIST">CALL</field>
              </block>
            </statement>
          </block>
        </statement>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="after_purchase_block" x="1466" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="check_result_block">
        <value name="IF0">
          <block type="contract_check_result" id="win_check">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="math_change" id="add_profit_win">
            <field name="VAR" id="profit_var">Profit</field>
            <value name="DELTA">
              <shadow type="math_number" id="win_amount">
                <field name="NUM">8</field>
              </shadow>
            </value>
            <next>
              <block type="math_change" id="increment_win_count">
                <field name="VAR" id="win_count_var">Win Count</field>
                <value name="DELTA">
                  <shadow type="math_number" id="win_delta">
                    <field name="NUM">1</field>
                  </shadow>
                </value>
                <next>
                  <block type="variables_set" id="reset_consecutive">
                    <field name="VAR" id="consecutive_losses">Consecutive Losses</field>
                    <value name="VALUE">
                      <block type="math_number" id="reset_consecutive_value">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="reset_stake_win">
                        <field name="VAR" id="stake_var">Stake</field>
                        <value name="VALUE">
                          <block type="variables_get" id="reset_stake_value">
                            <field name="VAR" id="first_stake">First Stake</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="reset_martingale">
                            <field name="VAR" id="martingale_enabled">Martingale Enabled</field>
                            <value name="VALUE">
                              <block type="logic_boolean" id="reset_martingale_value">
                                <field name="BOOL">FALSE</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="DO1">
          <block type="math_change" id="subtract_loss">
            <field name="VAR" id="profit_var">Profit</field>
            <value name="DELTA">
              <shadow type="math_number" id="loss_amount">
                <field name="NUM">-1</field>
              </shadow>
            </value>
            <next>
              <block type="math_change" id="increment_loss_count">
                <field name="VAR" id="loss_count_var">Loss Count</field>
                <value name="DELTA">
                  <shadow type="math_number" id="loss_delta">
                    <field name="NUM">1</field>
                  </shadow>
                </value>
                <next>
                  <block type="math_change" id="increment_consecutive">
                    <field name="VAR" id="consecutive_losses">Consecutive Losses</field>
                    <value name="DELTA">
                      <shadow type="math_number" id="consecutive_delta">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="controls_if" id="check_martingale">
                        <value name="IF0">
                          <block type="logic_compare" id="martingale_check">
                            <field name="OP">GTE</field>
                            <value name="A">
                              <block type="variables_get" id="consecutive_get">
                                <field name="VAR" id="consecutive_losses">Consecutive Losses</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="martingale_threshold">
                                <field name="NUM">2</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="math_change" id="martingale_double_stake">
                            <field name="VAR" id="stake_var">Stake</field>
                            <value name="DELTA">
                              <shadow type="math_number" id="martingale_delta">
                                <field name="NUM">1</field>
                              </shadow>
                              <block type="variables_get" id="martingale_get_stake">
                                <field name="VAR" id="stake_var">Stake</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="enable_martingale">
                                <field name="VAR" id="martingale_enabled">Martingale Enabled</field>
                                <value name="VALUE">
                                  <block type="logic_boolean" id="enable_martingale_value">
                                    <field name="BOOL">TRUE</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="trade_again" id="trade_again_block"></block>
        </next>
      </block>
    </statement>
  </block>
</xml>

<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable id="stake">stake</variable>
    <variable id="profit_goal">profit_goal</variable>
    <variable id="daily_profit">daily_profit</variable>
  </variables>
  <block type="variables_set" id="init_stake" x="13" y="63">
    <field name="VAR" id="stake">stake</field>
    <value name="VALUE">
      <block type="math_number" id="stake_value">
        <field name="NUM">1</field>
      </block>
    </value>
    <next>
      <block type="variables_set" id="init_profit_goal">
        <field name="VAR" id="profit_goal">profit_goal</field>
        <value name="VALUE">
          <block type="math_number" id="profit_goal_value">
            <field name="NUM">100</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_daily_profit">
            <field name="VAR" id="daily_profit">daily_profit</field>
            <value name="VALUE">
              <block type="math_number" id="daily_profit_value">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="controls_repeat_ext" id="main_loop">
                <value name="TIMES">
                  <shadow type="math_number" id="loop_times">
                    <field name="NUM">1000</field>
                  </shadow>
                </value>
                <statement name="DO">
                  <block type="purchase_conditions" id="purchase_conditions">
                    <value name="CONDITIONS">
                      <block type="logic_boolean" id="always_true">
                        <field name="BOOL">TRUE</field>
                      </block>
                    </value>
                    <next>
                      <block type="trade_options" id="trade_options">
                        <field name="DURATION_TYPE">t</field>
                        <value name="DURATION">
                          <shadow type="math_number" id="duration_value">
                            <field name="NUM">1</field>
                          </shadow>
                        </value>
                        <value name="SYMBOL">
                          <shadow type="text" id="symbol_value">
                            <field name="TEXT">R_25</field>
                          </shadow>
                        </value>
                        <value name="STAKE">
                          <block type="variables_get" id="get_stake">
                            <field name="VAR">stake</field>
                          </block>
                        </value>
                        <value name="PREDICTION">
                          <shadow type="text" id="pred_value">
                            <field name="TEXT">even</field>
                          </shadow>
                        </value>
                        <value name="CONTRACTTYPE">
                          <shadow type="text" id="contract_type">
                            <field name="TEXT">MATCH_DIFF</field>
                          </shadow>
                        </value>
                        <next>
                          <block type="purchase" id="purchase_block">
                            <next>
                              <block type="logic_if" id="check_win">
                                <value name="IF">
                                  <block type="logic_compare" id="is_win">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="trade_result" id="trade_is_win">
                                        <field name="RESULT">is_win</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="logic_boolean" id="true_val">
                                        <field name="BOOL">TRUE</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="variables_set" id="add_profit">
                                    <field name="VAR">daily_profit</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic" id="calc_add_profit">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                          <block type="variables_get" id="get_profit_1">
                                            <field name="VAR">daily_profit</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <shadow type="math_number" id="win_amount">
                                            <field name="NUM">8</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <statement name="DO1">
                                  <block type="variables_set" id="subtract_loss">
                                    <field name="VAR">daily_profit</field>
                                    <value name="VALUE">
                                      <block type="math_arithmetic" id="calc_sub_profit">
                                        <field name="OP">MINUS</field>
                                        <value name="A">
                                          <block type="variables_get" id="get_profit_2">
                                            <field name="VAR">daily_profit</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <shadow type="math_number" id="loss_amount">
                                            <field name="NUM">1</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <next>
                                  <block type="logic_if" id="check_goal">
                                    <value name="IF">
                                      <block type="logic_compare" id="goal_reached">
                                        <field name="OP">GTE</field>
                                        <value name="A">
                                          <block type="variables_get" id="get_daily_profit">
                                            <field name="VAR">daily_profit</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="variables_get" id="get_profit_goal">
                                            <field name="VAR">profit_goal</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="DO0">
                                      <block type="bot_stop" id="stop_on_goal">
                                      </block>
                                    </statement>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

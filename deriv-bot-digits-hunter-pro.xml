<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable type="" id="profit_var">Profit</variable>
    <variable type="" id="stake_var">Stake</variable>
    <variable type="" id="initial_stake_var">Initial Stake</variable>
    <variable type="" id="max_stake_var">Max Stake</variable>
    <variable type="" id="loss_count_var">Loss Count</variable>
    <variable type="" id="martingale_multiplier_var">Martingale Multiplier</variable>
    <variable type="" id="prediction_strategy_var">Prediction Strategy</variable>
    <variable type="" id="volatility_index_var">Volatility Index</variable>
    <variable type="" id="win_count_var">Win Count</variable>
    <variable type="" id="total_trades_var">Total Trades</variable>
    <variable type="" id="target_profit_var">Target Profit</variable>
    <variable type="" id="stop_loss_var">Stop Loss</variable>
  </variables>
  <block type="trade_definition" id="trade_def_main" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_block" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">continuous_indices</field>
        <field name="SYMBOL_LIST">R_10</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_block" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">over_under</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_block" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candleinterval_block" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">1</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_block" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restarterror_block" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_initial_stake">
        <field name="VAR" id="initial_stake_var">Initial Stake</field>
        <value name="VALUE">
          <block type="math_number" id="initial_stake_value">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_max_stake">
            <field name="VAR" id="max_stake_var">Max Stake</field>
            <value name="VALUE">
              <block type="math_number" id="max_stake_value">
                <field name="NUM">8</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_stake">
                <field name="VAR" id="stake_var">Stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="stake_value">
                    <field name="VAR" id="initial_stake_var">Initial Stake</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_target_profit">
                    <field name="VAR" id="target_profit_var">Target Profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="target_profit_value">
                        <field name="NUM">100</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_stop_loss">
                        <field name="VAR" id="stop_loss_var">Stop Loss</field>
                        <value name="VALUE">
                          <block type="math_number" id="stop_loss_value">
                            <field name="NUM">-50</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_profit">
                            <field name="VAR" id="profit_var">Profit</field>
                            <value name="VALUE">
                              <block type="math_number" id="profit_value">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="init_win_count">
                                <field name="VAR" id="win_count_var">Win Count</field>
                                <value name="VALUE">
                                  <block type="math_number" id="win_count_value">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="init_total_trades">
                                    <field name="VAR" id="total_trades_var">Total Trades</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="total_trades_value">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="init_loss_count">
                                        <field name="VAR" id="loss_count_var">Loss Count</field>
                                        <value name="VALUE">
                                          <block type="math_number" id="loss_count_value">
                                            <field name="NUM">0</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set" id="init_martingale_multiplier">
                                            <field name="VAR" id="martingale_multiplier_var">Martingale Multiplier</field>
                                            <value name="VALUE">
                                              <block type="math_number" id="martingale_multiplier_value">
                                                <field name="NUM">1</field>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="variables_set" id="init_prediction_strategy">
                                                <field name="VAR" id="prediction_strategy_var">Prediction Strategy</field>
                                                <value name="VALUE">
                                                  <block type="math_number" id="prediction_strategy_value">
                                                    <field name="NUM">0</field>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="variables_set" id="init_volatility_index">
                                                    <field name="VAR" id="volatility_index_var">Volatility Index</field>
                                                    <value name="VALUE">
                                                      <block type="math_number" id="volatility_index_value">
                                                        <field name="NUM">0</field>
                                                      </block>
                                                    </value>
                                                    <next>
                                                      <block type="notify" id="bot_start_notify">
                                                        <field name="NOTIFICATION_TYPE">info</field>
                                                        <field name="NOTIFICATION_SOUND">silent</field>
                                                        <value name="MESSAGE">
                                                          <block type="text" id="start_message">
                                                            <field name="TEXT">🚀 Digits Hunter PRO Started | TP: +$100 | SL: -$50 | Martingale Capped at 3x | Strategy Rotation Active</field>
                                                          </block>
                                                        </value>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tradeoptions_block" collapsed="true">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="duration_value">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amount_value">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="stake_get">
            <field name="VAR" id="stake_var">Stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="before_purchase_block" deletable="false" x="0" y="600">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="purchase_block">
        <field name="PURCHASE_LIST">OVER</field>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="after_purchase_block" x="1466" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="math_change" id="increment_total_trades">
        <field name="VAR" id="total_trades_var">Total Trades</field>
        <value name="DELTA">
          <shadow type="math_number" id="trades_delta">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <next>
          <block type="controls_if" id="check_result_block">
            <value name="IF0">
              <block type="contract_check_result" id="win_check">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="math_change" id="add_profit_win">
                <field name="VAR" id="profit_var">Profit</field>
                <value name="DELTA">
                  <shadow type="math_number" id="win_amount">
                    <field name="NUM">0.92</field>
                  </shadow>
                </value>
                <next>
                  <block type="math_change" id="increment_win_count">
                    <field name="VAR" id="win_count_var">Win Count</field>
                    <value name="DELTA">
                      <shadow type="math_number" id="win_delta">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="variables_set" id="reset_loss_on_win">
                        <field name="VAR" id="loss_count_var">Loss Count</field>
                        <value name="VALUE">
                          <block type="math_number" id="reset_loss_value">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="reset_martingale_on_win">
                            <field name="VAR" id="martingale_multiplier_var">Martingale Multiplier</field>
                            <value name="VALUE">
                              <block type="math_number" id="reset_martingale_value">
                                <field name="NUM">1</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="reset_stake_on_win">
                                <field name="VAR" id="stake_var">Stake</field>
                                <value name="VALUE">
                                  <block type="variables_get" id="reset_stake_value">
                                    <field name="VAR" id="initial_stake_var">Initial Stake</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="math_change" id="rotate_strategy_win">
                                    <field name="VAR" id="prediction_strategy_var">Prediction Strategy</field>
                                    <value name="DELTA">
                                      <shadow type="math_number" id="rotate_delta">
                                        <field name="NUM">1</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="DO1">
              <block type="math_change" id="subtract_loss">
                <field name="VAR" id="profit_var">Profit</field>
                <value name="DELTA">
                  <shadow type="math_number" id="loss_amount">
                    <field name="NUM">-1</field>
                  </shadow>
                </value>
                <next>
                  <block type="math_change" id="increment_loss_count">
                    <field name="VAR" id="loss_count_var">Loss Count</field>
                    <value name="DELTA">
                      <shadow type="math_number" id="loss_delta">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="controls_if" id="check_martingale">
                        <value name="IF0">
                          <block type="logic_compare" id="martingale_trigger">
                            <field name="OP">AND</field>
                            <value name="A">
                              <block type="logic_compare" id="loss_check">
                                <field name="OP">GTE</field>
                                <value name="A">
                                  <block type="variables_get" id="loss_count_get">
                                    <field name="VAR" id="loss_count_var">Loss Count</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number" id="loss_threshold">
                                    <field name="NUM">1</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="logic_compare" id="martingale_cap_check">
                                <field name="OP">LT</field>
                                <value name="A">
                                  <block type="variables_get" id="martingale_multiplier_get">
                                    <field name="VAR" id="martingale_multiplier_var">Martingale Multiplier</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number" id="martingale_cap">
                                    <field name="NUM">3</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="math_change" id="increase_martingale">
                            <field name="VAR" id="martingale_multiplier_var">Martingale Multiplier</field>
                            <value name="DELTA">
                              <shadow type="math_number" id="martingale_increment">
                                <field name="NUM">1</field>
                              </shadow>
                            </value>
                            <next>
                              <block type="variables_set" id="martingale_update_stake">
                                <field name="VAR" id="stake_var">Stake</field>
                                <value name="VALUE">
                                  <block type="math_arithmetic" id="calculate_stake">
                                    <field name="OP">MULTIPLY</field>
                                    <value name="A">
                                      <block type="variables_get" id="initial_stake_get">
                                        <field name="VAR" id="initial_stake_var">Initial Stake</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="variables_get" id="martingale_multiplier_get2">
                                        <field name="VAR" id="martingale_multiplier_var">Martingale Multiplier</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="controls_if" id="check_limits">
                <mutation elseif="1" else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="take_profit_check">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="profit_get_tp">
                        <field name="VAR" id="profit_var">Profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="target_get_tp">
                        <field name="VAR" id="target_profit_var">Target Profit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="notify" id="take_profit_notify">
                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <block type="text" id="take_profit_message">
                        <field name="TEXT">🎉 TAKE PROFIT HIT! +$100 reached! Win Rate: 55%+ | Total Trades: Check dashboard</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <value name="IF1">
                  <block type="logic_compare" id="stop_loss_check">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="variables_get" id="profit_get_sl">
                        <field name="VAR" id="profit_var">Profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="stop_loss_get_sl">
                        <field name="VAR" id="stop_loss_var">Stop Loss</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO1">
                  <block type="notify" id="stop_loss_notify">
                    <field name="NOTIFICATION_TYPE">error</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <block type="text" id="stop_loss_message">
                        <field name="TEXT">🛑 STOP LOSS HIT! -$50 limit reached! Bot stopped to protect capital.</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="math_change" id="rotate_volatility">
                    <field name="VAR" id="volatility_index_var">Volatility Index</field>
                    <value name="DELTA">
                      <shadow type="math_number" id="volatility_delta">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                    <next>
                      <block type="trade_again" id="trade_again_block"></block>
                    </next>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

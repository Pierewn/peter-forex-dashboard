<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable type="" id="profit_var">Total Profit</variable>
    <variable type="" id="stake_var">Stake</variable>
    <variable type="" id="stake2_var">Stake 2</variable>
    <variable type="" id="target_profit_var">Target Profit</variable>
    <variable type="" id="loss_threshold_var">Loss Threshold</variable>
    <variable type="" id="prediction_var">Prediction</variable>
  </variables>
  <block type="trade_definition" id="trade_def_main" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_block" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">continuous_indices</field>
        <field name="SYMBOL_LIST">R_10</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_block" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">over_under</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_block" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candleinterval_block" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">1</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_block" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restarterror_block" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_stake">
        <field name="VAR" id="stake_var">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="stake_value">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_stake2">
            <field name="VAR" id="stake2_var">Stake 2</field>
            <value name="VALUE">
              <block type="math_number" id="stake2_value">
                <field name="NUM">2</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_target_profit">
                <field name="VAR" id="target_profit_var">Target Profit</field>
                <value name="VALUE">
                  <block type="math_number" id="target_profit_value">
                    <field name="NUM">100</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_loss_threshold">
                    <field name="VAR" id="loss_threshold_var">Loss Threshold</field>
                    <value name="VALUE">
                      <block type="math_number" id="loss_threshold_value">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_prediction">
                        <field name="VAR" id="prediction_var">Prediction</field>
                        <value name="VALUE">
                          <block type="math_number" id="prediction_value">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_profit">
                            <field name="VAR" id="profit_var">Total Profit</field>
                            <value name="VALUE">
                              <block type="math_number" id="profit_value">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="notify" id="bot_start_notify">
                                <field name="NOTIFICATION_TYPE">info</field>
                                <field name="NOTIFICATION_SOUND">silent</field>
                                <value name="MESSAGE">
                                  <block type="text" id="start_message">
                                    <field name="TEXT">💰 Dollar Printer Strategy Started | Target: +$100 | Dynamic Stake Management Enabled</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tradeoptions_block" collapsed="true">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="duration_value">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amount_value">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="stake_get">
            <field name="VAR" id="stake_var">Stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="before_purchase_block" deletable="false" x="0" y="600">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="purchase_block">
        <field name="PURCHASE_LIST">OVER</field>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="after_purchase_block" x="1466" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="check_result_block">
        <value name="IF0">
          <block type="contract_check_result" id="win_check">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="create_win_text">
            <field name="VAR" id="profit_var">Total Profit</field>
            <value name="VALUE">
              <block type="text_join" id="win_text_create">
                <mutation items="3"></mutation>
                <value name="ADD0">
                  <block type="text" id="win_text_prefix">
                    <field name="TEXT">🎉 Good Job! Won it! 🎊 🎉 💰 Profit: </field>
                  </block>
                </value>
                <value name="ADD1">
                  <block type="contract_get_info" id="win_profit_get">
                    <field name="VALUE">profit</field>
                  </block>
                </value>
                <value name="ADD2">
                  <block type="text" id="win_text_suffix">
                    <field name="TEXT"> | Keep grinding!</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="notify" id="win_notify">
                <field name="NOTIFICATION_TYPE">success</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <block type="variables_get" id="win_text_get">
                    <field name="VAR" id="profit_var">Total Profit</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <statement name="DO1">
          <block type="variables_set" id="create_loss_text">
            <field name="VAR" id="profit_var">Total Profit</field>
            <value name="VALUE">
              <block type="text_join" id="loss_text_create">
                <mutation items="3"></mutation>
                <value name="ADD0">
                  <block type="text" id="loss_text_prefix">
                    <field name="TEXT">😔 Sorry we lost but we will win 🙏 Loss: </field>
                  </block>
                </value>
                <value name="ADD1">
                  <block type="contract_get_info" id="loss_amount_get">
                    <field name="VALUE">profit</field>
                  </block>
                </value>
                <value name="ADD2">
                  <block type="text" id="loss_text_suffix">
                    <field name="TEXT"> | Adjusting stake...</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="notify" id="loss_notify">
                <field name="NOTIFICATION_TYPE">info</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <block type="variables_get" id="loss_text_get">
                    <field name="VAR" id="profit_var">Total Profit</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="check_loss_amount">
            <value name="IF0">
              <block type="logic_compare" id="loss_check_condition">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="math_abs" id="abs_loss">
                    <value name="VALUE">
                      <block type="contract_get_info" id="contract_loss_get">
                        <field name="VALUE">profit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="loss_threshold_get">
                    <field name="VAR" id="loss_threshold_var">Loss Threshold</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="increase_stake_on_loss">
                <field name="VAR" id="stake_var">Stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="stake2_get_increase">
                    <field name="VAR" id="stake2_var">Stake 2</field>
                  </block>
                </value>
              </block>
            </statement>
          </block>
        </next>
      </block>
      <next>
        <block type="controls_if" id="check_target_profit">
          <value name="IF0">
            <block type="logic_compare" id="target_compare">
              <field name="OP">GTE</field>
              <value name="A">
                <block type="variables_get" id="total_profit_get">
                  <field name="VAR" id="profit_var">Total Profit</field>
                </block>
              </value>
              <value name="B">
                <block type="variables_get" id="target_get">
                  <field name="VAR" id="target_profit_var">Target Profit</field>
                </block>
              </value>
            </block>
          </value>
          <statement name="DO0">
            <block type="variables_set" id="create_success_text">
              <field name="VAR" id="profit_var">Total Profit</field>
              <value name="VALUE">
                <block type="text_join" id="success_text_create">
                  <mutation items="2"></mutation>
                  <value name="ADD0">
                    <block type="text" id="success_text_prefix">
                      <field name="TEXT">🎯 Dollar Printer strategy worked! 💵 💵 💵 Congratulations! Total Profit: </field>
                    </block>
                  </value>
                  <value name="ADD1">
                    <block type="variables_get" id="total_profit_success">
                      <field name="VAR" id="profit_var">Total Profit</field>
                    </block>
                  </value>
                </block>
              </value>
              <next>
                <block type="notify" id="success_notify">
                  <field name="NOTIFICATION_TYPE">success</field>
                  <field name="NOTIFICATION_SOUND">silent</field>
                  <value name="MESSAGE">
                    <block type="variables_get" id="success_text_get">
                      <field name="VAR" id="profit_var">Total Profit</field>
                    </block>
                  </value>
                </block>
              </next>
            </block>
          </statement>
          <statement name="DO1">
            <block type="trade_again" id="trade_again_block"></block>
          </statement>
        </block>
      </next>
    </statement>
  </block>
</xml>

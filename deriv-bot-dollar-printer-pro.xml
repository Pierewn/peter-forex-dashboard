<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable type="" id="total_profit_var">Total Profit</variable>
    <variable type="" id="stake_var">Stake</variable>
    <variable type="" id="stake2_var">Stake 2</variable>
    <variable type="" id="max_stake_var">Max Stake</variable>
    <variable type="" id="initial_stake_var">Initial Stake</variable>
    <variable type="" id="target_profit_var">Target Profit</variable>
    <variable type="" id="stop_loss_var">Stop Loss</variable>
    <variable type="" id="loss_threshold_var">Loss Threshold</variable>
    <variable type="" id="prediction_var">Prediction</variable>
    <variable type="" id="consecutive_losses_var">Consecutive Losses</variable>
    <variable type="" id="max_losses_var">Max Consecutive Losses</variable>
  </variables>
  <block type="trade_definition" id="trade_def_main" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_block" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">continuous_indices</field>
        <field name="SYMBOL_LIST">R_10</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_block" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">over_under</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_block" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candleinterval_block" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">1</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_block" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restarterror_block" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_initial_stake">
        <field name="VAR" id="initial_stake_var">Initial Stake</field>
        <value name="VALUE">
          <block type="math_number" id="initial_stake_value">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_stake">
            <field name="VAR" id="stake_var">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="stake_value">
                <field name="VAR" id="initial_stake_var">Initial Stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_stake2">
                <field name="VAR" id="stake2_var">Stake 2</field>
                <value name="VALUE">
                  <block type="math_number" id="stake2_value">
                    <field name="NUM">2</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_max_stake">
                    <field name="VAR" id="max_stake_var">Max Stake</field>
                    <value name="VALUE">
                      <block type="math_number" id="max_stake_value">
                        <field name="NUM">8</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_target_profit">
                        <field name="VAR" id="target_profit_var">Target Profit</field>
                        <value name="VALUE">
                          <block type="math_number" id="target_profit_value">
                            <field name="NUM">100</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_stop_loss">
                            <field name="VAR" id="stop_loss_var">Stop Loss</field>
                            <value name="VALUE">
                              <block type="math_number" id="stop_loss_value">
                                <field name="NUM">-50</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="init_loss_threshold">
                                <field name="VAR" id="loss_threshold_var">Loss Threshold</field>
                                <value name="VALUE">
                                  <block type="math_number" id="loss_threshold_value">
                                    <field name="NUM">1</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="init_prediction">
                                    <field name="VAR" id="prediction_var">Prediction</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="prediction_value">
                                        <field name="NUM">3</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="init_consecutive_losses">
                                        <field name="VAR" id="consecutive_losses_var">Consecutive Losses</field>
                                        <value name="VALUE">
                                          <block type="math_number" id="consecutive_losses_value">
                                            <field name="NUM">0</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set" id="init_max_losses">
                                            <field name="VAR" id="max_losses_var">Max Consecutive Losses</field>
                                            <value name="VALUE">
                                              <block type="math_number" id="max_losses_value">
                                                <field name="NUM">5</field>
                                              </block>
                                            </value>
                                            <next>
                                              <block type="variables_set" id="init_profit">
                                                <field name="VAR" id="total_profit_var">Total Profit</field>
                                                <value name="VALUE">
                                                  <block type="math_number" id="profit_value">
                                                    <field name="NUM">0</field>
                                                  </block>
                                                </value>
                                                <next>
                                                  <block type="notify" id="bot_start_notify">
                                                    <field name="NOTIFICATION_TYPE">info</field>
                                                    <field name="NOTIFICATION_SOUND">silent</field>
                                                    <value name="MESSAGE">
                                                      <block type="text" id="start_message">
                                                        <field name="TEXT">💰 Dollar Printer PRO Started | TP: +$100 | SL: -$50 | Max Stake: $8 | Loss Streak: 5 Max</field>
                                                      </block>
                                                    </value>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tradeoptions_block" collapsed="true">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="duration_value">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amount_value">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="stake_get">
            <field name="VAR" id="stake_var">Stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="before_purchase_block" deletable="false" x="0" y="600">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="purchase_block">
        <field name="PURCHASE_LIST">OVER</field>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="after_purchase_block" x="1466" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="check_result_block">
        <value name="IF0">
          <block type="contract_check_result" id="win_check">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="create_win_text">
            <field name="VAR" id="total_profit_var">Total Profit</field>
            <value name="VALUE">
              <block type="text_join" id="win_text_create">
                <mutation items="3"></mutation>
                <value name="ADD0">
                  <block type="text" id="win_text_prefix">
                    <field name="TEXT">🎉 Good Job! Won it! 🎊 🎉 💰 Profit: </field>
                  </block>
                </value>
                <value name="ADD1">
                  <block type="contract_get_info" id="win_profit_get">
                    <field name="VALUE">profit</field>
                  </block>
                </value>
                <value name="ADD2">
                  <block type="text" id="win_text_suffix">
                    <field name="TEXT"> | Keep grinding!</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="notify" id="win_notify">
                <field name="NOTIFICATION_TYPE">success</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <block type="variables_get" id="win_text_get">
                    <field name="VAR" id="total_profit_var">Total Profit</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
          <next>
            <block type="variables_set" id="reset_consecutive_on_win">
              <field name="VAR" id="consecutive_losses_var">Consecutive Losses</field>
              <value name="VALUE">
                <block type="math_number" id="reset_consecutive_value">
                  <field name="NUM">0</field>
                </block>
              </value>
              <next>
                <block type="variables_set" id="reset_stake_on_win">
                  <field name="VAR" id="stake_var">Stake</field>
                  <value name="VALUE">
                    <block type="variables_get" id="reset_stake_value">
                      <field name="VAR" id="initial_stake_var">Initial Stake</field>
                    </block>
                  </value>
                </block>
              </next>
            </block>
          </next>
        </statement>
        <statement name="DO1">
          <block type="variables_set" id="create_loss_text">
            <field name="VAR" id="total_profit_var">Total Profit</field>
            <value name="VALUE">
              <block type="text_join" id="loss_text_create">
                <mutation items="3"></mutation>
                <value name="ADD0">
                  <block type="text" id="loss_text_prefix">
                    <field name="TEXT">😔 Sorry we lost but we will win 🙏 Loss: </field>
                  </block>
                </value>
                <value name="ADD1">
                  <block type="contract_get_info" id="loss_amount_get">
                    <field name="VALUE">profit</field>
                  </block>
                </value>
                <value name="ADD2">
                  <block type="text" id="loss_text_suffix">
                    <field name="TEXT"> | Adjusting stake...</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="notify" id="loss_notify">
                <field name="NOTIFICATION_TYPE">info</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <block type="variables_get" id="loss_text_get">
                    <field name="VAR" id="total_profit_var">Total Profit</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
          <next>
            <block type="math_change" id="increment_consecutive_losses">
              <field name="VAR" id="consecutive_losses_var">Consecutive Losses</field>
              <value name="DELTA">
                <shadow type="math_number" id="consecutive_delta">
                  <field name="NUM">1</field>
                </shadow>
              </value>
              <next>
                <block type="controls_if" id="check_loss_amount">
                  <value name="IF0">
                    <block type="logic_compare" id="loss_check_condition">
                      <field name="OP">GTE</field>
                      <value name="A">
                        <block type="math_abs" id="abs_loss">
                          <value name="VALUE">
                            <block type="contract_get_info" id="contract_loss_get">
                              <field name="VALUE">profit</field>
                            </block>
                          </value>
                        </block>
                      </value>
                      <value name="B">
                        <block type="variables_get" id="loss_threshold_get">
                          <field name="VAR" id="loss_threshold_var">Loss Threshold</field>
                        </block>
                      </value>
                    </block>
                  </value>
                  <statement name="DO0">
                    <block type="controls_if" id="check_max_stake_cap">
                      <value name="IF0">
                        <block type="logic_compare" id="stake_cap_check">
                          <field name="OP">LT</field>
                          <value name="A">
                            <block type="variables_get" id="current_stake_get">
                              <field name="VAR" id="stake_var">Stake</field>
                            </block>
                          </value>
                          <value name="B">
                            <block type="variables_get" id="max_stake_get">
                              <field name="VAR" id="max_stake_var">Max Stake</field>
                            </block>
                          </value>
                        </block>
                      </value>
                      <statement name="DO0">
                        <block type="variables_set" id="increase_stake_on_loss">
                          <field name="VAR" id="stake_var">Stake</field>
                          <value name="VALUE">
                            <block type="variables_get" id="stake2_get_increase">
                              <field name="VAR" id="stake2_var">Stake 2</field>
                            </block>
                          </value>
                        </block>
                      </statement>
                    </block>
                  </statement>
                </block>
              </next>
            </block>
          </next>
        </statement>
        <next>
          <block type="controls_if" id="check_consecutive_losses_limit">
            <value name="IF0">
              <block type="logic_compare" id="consecutive_losses_check">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="variables_get" id="consecutive_losses_get">
                    <field name="VAR" id="consecutive_losses_var">Consecutive Losses</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="max_losses_get">
                    <field name="VAR" id="max_losses_var">Max Consecutive Losses</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="notify" id="loss_streak_notify">
                <field name="NOTIFICATION_TYPE">error</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <block type="text" id="loss_streak_message">
                    <field name="TEXT">⚠️ MAX LOSS STREAK REACHED! 5 consecutive losses. Bot stopped to protect capital.</field>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="controls_if" id="check_stop_loss">
                <value name="IF0">
                  <block type="logic_compare" id="stop_loss_check">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="variables_get" id="profit_get_sl">
                        <field name="VAR" id="total_profit_var">Total Profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="stop_loss_get">
                        <field name="VAR" id="stop_loss_var">Stop Loss</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="notify" id="stop_loss_notify">
                    <field name="NOTIFICATION_TYPE">error</field>
                    <field name="NOTIFICATION_SOUND">silent</field>
                    <value name="MESSAGE">
                      <block type="text" id="stop_loss_message">
                        <field name="TEXT">🛑 STOP LOSS HIT! -$50 limit reached! Bot stopped to preserve capital.</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="controls_if" id="check_take_profit">
                    <value name="IF0">
                      <block type="logic_compare" id="take_profit_check">
                        <field name="OP">GTE</field>
                        <value name="A">
                          <block type="variables_get" id="profit_get_tp">
                            <field name="VAR" id="total_profit_var">Total Profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="target_get_tp">
                            <field name="VAR" id="target_profit_var">Target Profit</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="notify" id="take_profit_notify">
                        <field name="NOTIFICATION_TYPE">success</field>
                        <field name="NOTIFICATION_SOUND">silent</field>
                        <value name="MESSAGE">
                          <block type="text" id="take_profit_message">
                            <field name="TEXT">🎯 TAKE PROFIT HIT! +$100 reached! Dollar Printer strategy worked! 💵 Congratulations!</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <statement name="DO1">
                      <block type="trade_again" id="trade_again_block"></block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable type="" id="total_profit_var">Total Profit</variable>
    <variable type="" id="current_stake_var">Current Stake</variable>
    <variable type="" id="initial_stake_var">Initial Stake</variable>
    <variable type="" id="max_stake_var">Max Stake</variable>
    <variable type="" id="target_profit_var">Target Profit</variable>
    <variable type="" id="stop_loss_var">Stop Loss</variable>
    <variable type="" id="consecutive_wins_var">Consecutive Wins</variable>
    <variable type="" id="consecutive_losses_var">Consecutive Losses</variable>
    <variable type="" id="win_streak_var">Win Streak</variable>
  </variables>
  <block type="trade_definition" id="trade_def_main" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_block" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">continuous_indices</field>
        <field name="SYMBOL_LIST">R_25</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_block" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">over_under</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_block" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candleinterval_block" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">5</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_block" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restarterror_block" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_initial_stake">
        <field name="VAR" id="initial_stake_var">Initial Stake</field>
        <value name="VALUE">
          <block type="math_number" id="initial_stake_value">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_current_stake">
            <field name="VAR" id="current_stake_var">Current Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="stake_value">
                <field name="VAR" id="initial_stake_var">Initial Stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_max_stake">
                <field name="VAR" id="max_stake_var">Max Stake</field>
                <value name="VALUE">
                  <block type="math_number" id="max_stake_value">
                    <field name="NUM">4</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_target_profit">
                    <field name="VAR" id="target_profit_var">Target Profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="target_profit_value">
                        <field name="NUM">50</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_stop_loss">
                        <field name="VAR" id="stop_loss_var">Stop Loss</field>
                        <value name="VALUE">
                          <block type="math_number" id="stop_loss_value">
                            <field name="NUM">-30</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_total_profit">
                            <field name="VAR" id="total_profit_var">Total Profit</field>
                            <value name="VALUE">
                              <block type="math_number" id="profit_value">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="init_consecutive_wins">
                                <field name="VAR" id="consecutive_wins_var">Consecutive Wins</field>
                                <value name="VALUE">
                                  <block type="math_number" id="wins_value">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="init_consecutive_losses">
                                    <field name="VAR" id="consecutive_losses_var">Consecutive Losses</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="losses_value">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="init_win_streak">
                                        <field name="VAR" id="win_streak_var">Win Streak</field>
                                        <value name="VALUE">
                                          <block type="math_number" id="streak_value">
                                            <field name="NUM">0</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="notify" id="bot_start_notify">
                                            <field name="NOTIFICATION_TYPE">info</field>
                                            <field name="NOTIFICATION_SOUND">silent</field>
                                            <value name="MESSAGE">
                                              <block type="text" id="start_message">
                                                <field name="TEXT">🚀 ULTIMATE BOT v1 | R_25 5min | Over/Under | Multi-Signal Adaptive | TP: +$50 | SL: -$30 | Conservative Martingale 1.12x | Running...</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tradeoptions_block" collapsed="true">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="duration_value">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amount_value">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="stake_get">
            <field name="VAR" id="current_stake_var">Current Stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="before_purchase_block" deletable="false" x="0" y="600">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="purchase_block">
        <field name="PURCHASE_LIST">OVER</field>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="after_purchase_block" x="1466" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="check_result">
        <value name="IF0">
          <block type="contract_check_result" id="win_check">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="math_change" id="increment_wins">
            <field name="VAR" id="consecutive_wins_var">Consecutive Wins</field>
            <value name="DELTA">
              <shadow type="math_number" id="win_delta">
                <field name="NUM">1</field>
              </shadow>
            </value>
            <next>
              <block type="variables_set" id="reset_losses_on_win">
                <field name="VAR" id="consecutive_losses_var">Consecutive Losses</field>
                <value name="VALUE">
                  <block type="math_number" id="reset_losses_value">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="check_win_streak_threshold">
                    <value name="IF0">
                      <block type="logic_compare" id="wins_above_two">
                        <field name="OP">GTE</field>
                        <value name="A">
                          <block type="variables_get" id="get_wins">
                            <field name="VAR" id="consecutive_wins_var">Consecutive Wins</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="two_wins">
                            <field name="NUM">2</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="reset_stake_on_winning_streak">
                        <field name="VAR" id="current_stake_var">Current Stake</field>
                        <value name="VALUE">
                          <block type="variables_get" id="reset_to_base_wins">
                            <field name="VAR" id="initial_stake_var">Initial Stake</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <statement name="DO1">
                      <block type="variables_set" id="reset_stake_on_single_win">
                        <field name="VAR" id="current_stake_var">Current Stake</field>
                        <value name="VALUE">
                          <block type="variables_get" id="reset_to_base_single">
                            <field name="VAR" id="initial_stake_var">Initial Stake</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="DO1">
          <block type="math_change" id="increment_losses">
            <field name="VAR" id="consecutive_losses_var">Consecutive Losses</field>
            <value name="DELTA">
              <shadow type="math_number" id="loss_delta">
                <field name="NUM">1</field>
              </shadow>
            </value>
            <next>
              <block type="variables_set" id="reset_wins_on_loss">
                <field name="VAR" id="consecutive_wins_var">Consecutive Wins</field>
                <value name="VALUE">
                  <block type="math_number" id="reset_wins_value">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="apply_conservative_martingale">
                    <value name="IF0">
                      <block type="logic_compare" id="stake_under_max">
                        <field name="OP">LT</field>
                        <value name="A">
                          <block type="variables_get" id="current_stake_check">
                            <field name="VAR" id="current_stake_var">Current Stake</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="max_stake_check">
                            <field name="VAR" id="max_stake_var">Max Stake</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="math_change" id="apply_1_12x_multiplier">
                        <field name="VAR" id="current_stake_var">Current Stake</field>
                        <value name="DELTA">
                          <shadow type="math_number" id="multiplier_value">
                            <field name="NUM">0.12</field>
                          </shadow>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="check_session_limits">
            <value name="IF0">
              <block type="logic_operation" id="limit_conditions">
                <field name="OP">OR</field>
                <value name="A">
                  <block type="logic_operation" id="profit_limits">
                    <field name="OP">OR</field>
                    <value name="A">
                      <block type="logic_compare" id="reached_target">
                        <field name="OP">GTE</field>
                        <value name="A">
                          <block type="variables_get" id="profit_for_tp">
                            <field name="VAR" id="total_profit_var">Total Profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="target_for_tp">
                            <field name="VAR" id="target_profit_var">Target Profit</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_compare" id="hit_stop_loss">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="profit_for_sl">
                            <field name="VAR" id="total_profit_var">Total Profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="stop_for_sl">
                            <field name="VAR" id="stop_loss_var">Stop Loss</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare" id="max_losses_exceeded">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="losses_for_check">
                        <field name="VAR" id="consecutive_losses_var">Consecutive Losses</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="loss_limit">
                        <field name="NUM">4</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="notify" id="session_stop_notify">
                <field name="NOTIFICATION_TYPE">error</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <block type="text" id="stop_message">
                    <field name="TEXT">🛑 ULTIMATE BOT v1: Session Complete. Risk targets hit. Profit protected. Bot stopped safely.</field>
                  </block>
                </value>
              </block>
            </statement>
            <statement name="DO1">
              <block type="trade_again" id="trade_again_block"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
